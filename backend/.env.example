# TenkaiDanmaku Relay Server — 环境变量
# 复制此文件为 .env 后修改，.env 不会被提交到 Git

# HTTP / WebSocket 监听端口
PORT=3000

# 客户端认证超时（毫秒），超时未发送 auth 则断开
AUTH_TIMEOUT_MS=5000

# 每条 WebSocket 连接的最小发送间隔（毫秒），即速率限制
RATE_LIMIT_MS=1000

# 同一 IP 最大并发连接数
MAX_CONNS_PER_IP=5

# WebSocket 协议层 ping 间隔（毫秒），保持连接活跃
PING_INTERVAL_MS=30000

# 空分组延迟清理时间（毫秒），组内无客户端后等待此时间再删除
GROUP_TTL_MS=60000
